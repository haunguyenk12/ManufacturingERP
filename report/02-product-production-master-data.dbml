  }
}

Table item_standard_costs {
  item_standard_cost_id uuid [pk, not null, default: `gen_random_uuid()`]
  company_id uuid [not null]
  item_id uuid [not null, unique]
  material_cost numeric(19,6) [not null, default: 0]
  labor_cost numeric(19,6) [not null, default: 0]
  overhead_cost numeric(19,6) [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  created_by uuid
  updated_by uuid
  version bigint [default: 0]

  checks {
    `labor_cost >= 0::numeric` [name: 'chk_item_standard_costs_labor_cost']
    `material_cost >= 0::numeric` [name: 'chk_item_standard_costs_material_cost']
    `overhead_cost >= 0::numeric` [name: 'chk_item_standard_costs_overhead_cost']
  }
}

Table companies [note: 'External reference table. Only relationship columns are shown; see its owning module for the full definition.'] {
  company_id uuid [pk, not null, default: `gen_random_uuid()`]
}

Table plants [note: 'External reference table. Only relationship columns are shown; see its owning module for the full definition.'] {
