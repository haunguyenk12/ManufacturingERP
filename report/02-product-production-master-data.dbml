Project manufacturing_erp_02_product_production_master_data {
  database_type: 'PostgreSQL'
  Note: 'Manufacturing ERP 02-product-production-master-data module. Source: live PostgreSQL schema after Flyway V65 (add entity name to audit logs). External tables are relationship-only stubs.'
}

Table uoms {
  uom_id uuid [pk, not null, default: `gen_random_uuid()`]
  code varchar(20) [not null, unique]
  name varchar(100) [not null]
  description text
  status varchar(20) [not null, default: 'ACTIVE']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  created_by uuid
  updated_by uuid
  version bigint [default: 0]

  checks {
    `status::text = ANY (ARRAY['ACTIVE'::character varying, 'INACTIVE'::character varying]::text[])` [name: 'chk_uoms_status']
  }
}

Table items {
  item_id uuid [pk, not null, default: `gen_random_uuid()`]
  company_id uuid [not null]
  code varchar(100) [not null]
  name varchar(255) [not null]
  type varchar(50) [not null]
  unit varchar(30) [not null]
  lot_tracked boolean [not null, default: false]
  status varchar(20) [not null, default: 'ACTIVE']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  created_by uuid
  updated_by uuid
  version bigint [default: 0]
  serial_tracked boolean [not null, default: false]

  indexes {
    (company_id, code) [unique, name: 'uk_items_company_code']
  }

  checks {
    `status::text = ANY (ARRAY['ACTIVE'::character varying, 'INACTIVE'::character varying]::text[])` [name: 'chk_items_status']
    `NOT (lot_tracked AND serial_tracked)` [name: 'chk_items_tracking_exclusive']
    `type::text = ANY (ARRAY['RAW_MATERIAL'::character varying, 'WIP'::character varying, 'FINISHED_GOOD'::character varying, 'CONSUMABLE'::character varying, 'SERVICE'::character varying]::text[])` [name: 'chk_items_type']
  }
}

Table bom_headers {
  bom_id uuid [pk, not null, default: `gen_random_uuid()`]
  company_id uuid [not null]
  parent_item_id uuid [not null]
  revision varchar(40) [not null]
  status varchar(20) [not null, default: 'DRAFT']
  description text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  created_by uuid
  updated_by uuid
  version bigint [default: 0]

  indexes {
    (company_id, parent_item_id, revision) [unique, name: 'uk_bom_headers_company_parent_revision']
  }

  checks {
    `status::text = ANY (ARRAY['DRAFT'::character varying, 'ACTIVE'::character varying, 'INACTIVE'::character varying]::text[])` [name: 'chk_bom_headers_status']
  }
}

Table bom_lines {
  line_id uuid [pk, not null, default: `gen_random_uuid()`]
  bom_id uuid [not null]
  component_item_id uuid [not null]
  line_no integer [not null]
  quantity_per numeric(19,6) [not null]
  scrap_rate numeric(9,6) [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  created_by uuid
  updated_by uuid
  version bigint [default: 0]

  indexes {
    (bom_id, component_item_id) [unique, name: 'uk_bom_lines_bom_component']
    (bom_id, line_no) [unique, name: 'uk_bom_lines_bom_line_no']
  }

  checks {
    `quantity_per > 0::numeric` [name: 'chk_bom_lines_quantity']
    `scrap_rate >= 0::numeric AND scrap_rate < 1::numeric` [name: 'chk_bom_lines_scrap_rate']
  }
}

Table routings {
  routing_id uuid [pk, not null, default: `gen_random_uuid()`]
  company_id uuid [not null]
  item_id uuid [not null]
  code varchar(100) [not null]
  routing_version varchar(40) [not null]
  status varchar(20) [not null, default: 'DRAFT']
  note text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  created_by uuid
  updated_by uuid
  version bigint [default: 0]

  indexes {
    (company_id, code, routing_version) [unique, name: 'uk_routings_company_code_version']
  }

  checks {
    `status::text = ANY (ARRAY['DRAFT'::character varying, 'ACTIVE'::character varying, 'INACTIVE'::character varying]::text[])` [name: 'chk_routings_status']
  }
}

Table routing_operations {
  routing_operation_id uuid [pk, not null, default: `gen_random_uuid()`]
  routing_id uuid [not null]
  sequence integer [not null]
  name varchar(255) [not null]
  work_center_code varchar(100)
  setup_minutes numeric(19,6) [not null, default: 0]
  run_minutes_per_unit numeric(19,6) [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  created_by uuid
  updated_by uuid
  version bigint [default: 0]
  work_center_id uuid

  indexes {
    (routing_id, sequence) [unique, name: 'uk_routing_operations_sequence']
  }

  checks {
    `run_minutes_per_unit >= 0::numeric` [name: 'chk_routing_operations_run']
    `sequence > 0` [name: 'chk_routing_operations_sequence']
    `setup_minutes >= 0::numeric` [name: 'chk_routing_operations_setup']
  }
}

Table work_centers {
  work_center_id uuid [pk, not null, default: `gen_random_uuid()`]
  plant_id uuid [not null]
  code varchar(100) [not null]
  name varchar(255) [not null]
  description text
  capacity_unit_type varchar(20) [not null]
  capacity_units integer [not null]
  status varchar(20) [not null, default: 'ACTIVE']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  created_by uuid
  updated_by uuid
  version bigint [default: 0]
  work_calendar_id uuid

  indexes {
    (plant_id, code) [unique, name: 'uk_work_centers_plant_code']
  }

  checks {
    `capacity_unit_type::text = ANY (ARRAY['MACHINE'::character varying, 'LINE'::character varying, 'LABOR_TEAM'::character varying]::text[])` [name: 'chk_work_centers_capacity_unit_type']
    `capacity_units > 0` [name: 'chk_work_centers_capacity_units']
    `status::text = ANY (ARRAY['ACTIVE'::character varying, 'INACTIVE'::character varying]::text[])` [name: 'chk_work_centers_status']
  }
}

