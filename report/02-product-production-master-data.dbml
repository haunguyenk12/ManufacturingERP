}

Ref bom_headers_company_id_fkey: bom_headers.company_id > companies.company_id
Ref bom_headers_parent_item_id_fkey: bom_headers.parent_item_id > items.item_id
Ref bom_lines_bom_id_fkey: bom_lines.bom_id > bom_headers.bom_id [delete: cascade]
Ref bom_lines_component_item_id_fkey: bom_lines.component_item_id > items.item_id
Ref item_standard_costs_company_id_fkey: item_standard_costs.company_id > companies.company_id
Ref item_standard_costs_item_id_fkey: item_standard_costs.item_id - items.item_id
Ref items_company_id_fkey: items.company_id > companies.company_id
Ref routing_operations_routing_id_fkey: routing_operations.routing_id > routings.routing_id
Ref routing_operations_work_center_id_fkey: routing_operations.work_center_id > work_centers.work_center_id
Ref routings_company_id_fkey: routings.company_id > companies.company_id
Ref routings_item_id_fkey: routings.item_id > items.item_id
Ref shift_breaks_shift_id_fkey: shift_breaks.shift_id > shifts.shift_id
Ref shifts_plant_id_fkey: shifts.plant_id > plants.plant_id
Ref work_calendar_exceptions_work_calendar_id_fkey: work_calendar_exceptions.work_calendar_id > work_calendars.work_calendar_id
Ref work_calendar_weekly_shifts_shift_id_fkey: work_calendar_weekly_shifts.shift_id > shifts.shift_id
Ref work_calendar_weekly_shifts_work_calendar_id_fkey: work_calendar_weekly_shifts.work_calendar_id > work_calendars.work_calendar_id
Ref work_calendars_plant_id_fkey: work_calendars.plant_id > plants.plant_id
Ref work_centers_plant_id_fkey: work_centers.plant_id > plants.plant_id
Ref work_centers_work_calendar_id_fkey: work_centers.work_calendar_id > work_calendars.work_calendar_id

