Table work_calendar_weekly_shifts {
  work_calendar_weekly_shift_id uuid [pk, not null, default: `gen_random_uuid()`]
  work_calendar_id uuid [not null]
  weekday varchar(10) [not null]
  shift_id uuid [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  created_by uuid
  updated_by uuid
  version bigint [default: 0]

  indexes {
    (work_calendar_id, weekday, shift_id) [unique, name: 'uk_work_calendar_weekly_shifts']
  }

  checks {
    `weekday::text = ANY (ARRAY['MONDAY'::character varying, 'TUESDAY'::character varying, 'WEDNESDAY'::character varying, 'THURSDAY'::character varying, 'FRIDAY'::character varying, 'SATURDAY'::character varying, 'SUNDAY'::character varying]::text[])` [name: 'chk_work_calendar_weekly_shifts_weekday']
  }
}

Table work_calendar_exceptions {
  work_calendar_exception_id uuid [pk, not null, default: `gen_random_uuid()`]
