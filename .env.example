# Copy to .env, replace every placeholder, then activate dev outside this file:
# mvn spring-boot:run "-Dspring-boot.run.profiles=dev"
COMPOSE_PROJECT_NAME=manufacturing-erp-local
DB_URL=jdbc:postgresql://localhost:5434/manufacturing_erp
DB_USERNAME=manufacturing_erp
DB_PASSWORD=123456
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_CONNECTION_TIMEOUT_MS=30000
DB_IDLE_TIMEOUT_MS=600000
DB_MAX_LIFETIME_MS=1800000
POSTGRES_DB=manufacturing_erp
POSTGRES_USER=manufacturing_erp
POSTGRES_PASSWORD=123456
POSTGRES_HOST_PORT=5434
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_HOST_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=123456
REDIS_SSL_ENABLED=false
REDIS_TIMEOUT=2000ms
SERVER_PORT=8080
MANAGEMENT_SERVER_PORT=8081
SPRINGDOC_API_DOCS_ENABLED=false
SPRINGDOC_SWAGGER_UI_ENABLED=false
MANAGEMENT_ENDPOINTS_EXPOSURE_INCLUDE=health,info,metrics,prometheus
MANAGEMENT_HEALTH_SHOW_DETAILS=when-authorized
JWT_SECRET=replace-with-at-least-32-random-bytes-never-use-in-production
JWT_ISSUER=manufacturing-erp-dev
JWT_AUDIENCE=manufacturing-erp-dev-clients
JWT_ACCESS_TOKEN_EXPIRY_MS=900000
JWT_REFRESH_TOKEN_EXPIRY_MS=604800000
JWT_ABSOLUTE_SESSION_TIMEOUT_MS=2592000000
SECURITY_TRUSTED_PROXIES=127.0.0.1,::1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOWED_METHODS=GET,POST,PATCH,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type,Idempotency-Key,X-Plant-Id,X-Trace-Id
CORS_EXPOSED_HEADERS=X-Trace-Id,X-RateLimit-Limit,X-RateLimit-Remaining,X-RateLimit-Rule,Retry-After
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE_SECONDS=3600
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL_IP_LIMIT=200
RATE_LIMIT_AUTH_IP_LIMIT=10
RATE_LIMIT_REFRESH_IP_LIMIT=20
RATE_LIMIT_GLOBAL_USER_LIMIT=500
RATE_LIMIT_WINDOW_SECONDS=60
DATA_IMPORT_MAX_ROWS=5000
MULTIPART_MAX_FILE_SIZE=10MB
MULTIPART_MAX_REQUEST_SIZE=12MB
SPRINGDOC_API_DOCS_ENABLED=true
SPRINGDOC_SWAGGER_UI_ENABLED=true
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG
LOG_LEVEL_HIBERNATE_SQL=DEBUG
LOG_LEVEL_HIBERNATE_BIND=INFO
APP_BOOTSTRAP_ADMIN_ENABLED=false
APP_BOOTSTRAP_ADMIN_USERNAME=admin
APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_PASSWORD=
