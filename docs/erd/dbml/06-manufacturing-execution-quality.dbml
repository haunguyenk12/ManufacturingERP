}

Ref material_issue_lines_component_line_id_fkey: material_issue_lines.component_line_id > work_order_component_lines.component_line_id
Ref material_issue_lines_issue_id_fkey: material_issue_lines.issue_id > material_issues.issue_id [delete: cascade]
