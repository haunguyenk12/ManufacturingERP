TableGroup module_06_manufacturing_execution_quality {
  work_orders
  work_order_component_lines
  work_order_operations
  material_reservations
  material_issues
  material_issue_lines
  wip_transactions
  production_executions
  production_receipts
  production_receipt_lines
  quality_dispositions
  work_order_demand_allocations
  work_order_cost_accumulators
}

