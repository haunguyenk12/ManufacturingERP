Ref production_receipt_lines_stock_movement_id_fkey: production_receipt_lines.stock_movement_id > stock_movements.movement_id
Ref production_receipt_lines_warehouse_id_fkey: production_receipt_lines.warehouse_id > warehouses.warehouse_id
