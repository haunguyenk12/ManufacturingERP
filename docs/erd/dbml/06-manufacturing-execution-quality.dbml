Ref wip_transactions_work_order_operation_id_fkey: wip_transactions.work_order_operation_id > work_order_operations.work_order_operation_id
Ref work_order_component_lines_bom_line_id_fkey: work_order_component_lines.bom_line_id > bom_lines.line_id
